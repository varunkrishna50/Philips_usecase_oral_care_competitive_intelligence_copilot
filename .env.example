# Copy this file to .env and fill in a real key. .env is gitignored and
# never committed; this file holds placeholders only.
#
# Optional. The application and the full test suite both work with no key
# configured at all -- every question still gets a fully grounded answer via
# the deterministic fallback, and offline evaluation never calls a real API.
# A key is only needed to exercise the LLM-authored prose/summary path.
OPENAI_API_KEY=

# Optional overrides. Uncomment to change the defaults.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# DEEPEVAL_JUDGE_MODEL=gpt-4.1
